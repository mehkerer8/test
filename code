# ==================== KONFİGÜRASYON ====================
GITHUB_REPO = "mehkerer8/braille-kitaplar"
GITHUB_API_URL = f"https://api.github.com/repos/{GITHUB_REPO}/contents/pdfs"
LOCAL_BOOKS_DIR = "/home/pixel/braille_books"
UPDATE_INTERVAL = 3600  # 1 saatte bir otomatik kontrol (saniye)

# ==================== SES AYARLARI ====================
VOICE_SETTINGS = {
    'speed': 100,          # Çok yavaş (normal 150-200)
    'pitch': 40,           # Daha kalın ses
    'volume': 200,         # Maksimum ses
    'gap': 10,             # Kelimeler arası boşluk
    'capital_delay': 50,   # Büyük harf sonrası duraklama
    'voice': 'tr'          # Türkçe ses
}

# ==================== GPIO AYARLARI ====================
class GPIOPins:
    # Röle Pinleri (6 solenoid için)
    RELAY_PINS = [4, 17, 27, 22, 23, 24]
    
    # Buton Pinleri
    BUTTON_NEXT = 5        # Sonraki kitap
    BUTTON_CONFIRM = 6     # Onay/Seçim
    BUTTON_MODE = 13       # Mod değiştirme
    BUTTON_SPEED_UP = 19   # Hız artırma
    BUTTON_SPEED_DOWN = 26 # Hız azaltma
    BUTTON_UPDATE = 21     # Kitapları güncelle
    
    ALL_BUTTONS = [BUTTON_NEXT, BUTTON_CONFIRM, BUTTON_MODE, 
                   BUTTON_SPEED_UP, BUTTON_SPEED_DOWN, BUTTON_UPDATE]

# ==================== BRAILLE KİTAP OKUYUCU ====================
class BrailleBookReader:
    def __init__(self):
        print("🎵 Yüksek Kaliteli Braille Kitap Okuyucu Başlatılıyor...")
        
        # GPIO Ayarları
        GPIO.setmode(GPIO.BCM)
        GPIO.setwarnings(False)
        
        try:
            GPIO.cleanup()
            time.sleep(0.5)
        except:
            pass
        
        # Ses motorunu başlat
        self.setup_voice_engine()
        
        # Değişkenler
        self.books = []
        self.current_book_index = 0
        self.selected_book = None
        self.current_mode = 0
        self.modes = ["sadece_yazma", "sadece_okuma", "hem_okuma_hem_yazma", "egitim_modu"]
        self.mode_names = ["Sadece Yazma", "Sadece Okuma", "Hem Okuma Hem Yazma", "Braille Eğitimi"]
        
        # Ses ayarları (kullanıcı tarafından değiştirilebilir)
        self.speech_settings = VOICE_SETTINGS.copy()
        
        # Sistem durumu
        self.is_running = True
        self.is_playing = False
        self.stop_event = Event()
        self.progress_data = {}
        self.current_position = 0
        self.current_text = ""
        
        # Buton takibi
        self.button_states = {}
        self.last_button_time = {}
        self.lock = Lock()
        
        # Dizinleri oluştur
        self.setup_directories()
        
        # GPIO'yu ayarla
        self.setup_gpio()
        
        # Braille haritasını yükle
        self.setup_braille_map()
        
        # İlerlemeyi yükle
        self.load_progress()
        
        # Kitapları yükle (yerelden)
        self.load_local_books()
        
        # Otomatik güncelleme thread'i
        self.update_thread = Thread(target=self.auto_update_check, daemon=True)
        self.update_thread.start()
        
        # Başlangıç mesajı
        self.speak("Merhaba! Braille kitap okuyucuya hoş geldiniz.", premium=True)
        time.sleep(1)
        
        if self.books:
            self.speak(f"Kütüphanenizde {len(self.books)} kitap bulunuyor.", premium=True)
            time.sleep(1)
            self.speak(f"İlk kitap: {self.books[0]['name_tr']}", premium=True)
        else:
            self.speak("Henüz hiç kitap yok. Lütfen güncelle tuşuna basarak kitapları indirin.", premium=True)
        
        self.speak("İleri tuşu ile kitaplar arasında gezin, onay tuşu ile seçin.", premium=True)
        
        print("✅ Sistem hazır!")
    
    # ==================== SES SİSTEMİ (İYİLEŞTİRİLMİŞ) ====================
    def setup_voice_engine(self):
        """Gelişmiş ses motorunu başlat"""
        print("🔊 Premium ses motoru yükleniyor...")
        
        # eSpeak'i kontrol et
        try:
            subprocess.run(['espeak', '--version'], capture_output=True)
            print("✅ eSpeak kurulu")
        except:
            print("❌ eSpeak bulunamadı, kuruluyor...")
            subprocess.run(['sudo', 'apt', 'install', '-y', 'espeak', 'espeak-data'])
    
    def speak(self, text, wait=True, premium=False):
        """
        Gelişmiş seslendirme sistemi
        premium=True: Daha yavaş ve net konuşma
        """
        try:
            # Metni Türkçe karakterlere göre düzenle
            text = self.fix_turkish_text(text)
            
            # Premium ses ayarları
            if premium:
                settings = {
                    'speed': 90,     # Daha yavaş
                    'pitch': 35,     # Daha kalın
                    'volume': 200,   # Tam ses
                    'gap': 15        # Daha fazla boşluk
                }
            else:
                settings = self.speech_settings
            
            # eSpeak komutunu oluştur
            cmd = [
                'espeak',
                '-v', f"{settings['voice']}+f3",  # Kadın sesi (+f3)
                '-s', str(settings['speed']),
                '-p', str(settings['pitch']),
                '-a', str(settings['volume']),
                '-g', str(settings['gap']),
                '-k', '5',  # Büyük harf vurgusu
                '--punct=".,;:!?"',  # Noktalama işaretlerini oku
                f'"{text}"'
            ]
            
            if wait:
                # Daha kaliteli ses için pulseaudio kullan
                try:
                    subprocess.run(cmd, stdout=subprocess.DEVNULL, 
                                 stderr=subprocess.DEVNULL, 
                                 timeout=len(text)/10)
                except subprocess.TimeoutExpired:
                    pass
            else:
                # Asenkron konuşma
                def speak_async():
                    subprocess.run(cmd, stdout=subprocess.DEVNULL, 
                                 stderr=subprocess.DEVNULL)
                Thread(target=speak_async, daemon=True).start()
                
        except Exception as e:
            print(f"Ses hatası: {e}")
    
    def fix_turkish_text(self, text):
        """Türkçe karakterleri düzelt"""
        replacements = {
            'ı': 'i', 'İ': 'I',
            'ğ': 'g', 'Ğ': 'G',
            'ü': 'u', 'Ü': 'U',
            'ş': 's', 'Ş': 'S',
            'ö': 'o', 'Ö': 'O',
            'ç': 'c', 'Ç': 'C'
        }
        
        for old, new in replacements.items():
            text = text.replace(old, new)
        return text
    
    def adjust_speech_speed(self, increase=True):
        """Konuşma hızını ayarla"""
        with self.lock:
            if increase:
                self.speech_settings['speed'] = min(200, self.speech_settings['speed'] + 10)
            else:
                self.speech_settings['speed'] = max(60, self.speech_settings['speed'] - 10)
            
            self.speak(f"Ses hızı: {self.speech_settings['speed']}", premium=True)
    
    # ==================== GİTHUB OTOMATİK PDF SİSTEMİ ====================
    def setup_directories(self):
        """Gerekli dizinleri oluştur"""
        os.makedirs(LOCAL_BOOKS_DIR, exist_ok=True)
        os.makedirs(f"{LOCAL_BOOKS_DIR}/pdfs", exist_ok=True)
        os.makedirs(f"{LOCAL_BOOKS_DIR}/cache", exist_ok=True)
    
    def load_local_books(self):
        """Yerel kitapları yükle"""
        auto_file = f"{LOCAL_BOOKS_DIR}/kitaplar_auto.json"
        
        if os.path.exists(auto_file):
            try:
                with open(auto_file, 'r', encoding='utf-8') as f:
                    self.books = json.load(f)
                print(f"📚 {len(self.books)} kitap yüklendi")
                
                # Kitapları sesli duyur
                if self.books:
                    self.speak(f"{len(self.books)} kitap yüklendi", premium=True)
                    
            except Exception as e:
                print(f"Kitaplar yüklenirken hata: {e}")
                self.books = []
        else:
            self.books = []
            print("ℹ️ Henüz kitap yok, ilk güncellemeyi bekliyor...")
    
    def scan_github_for_pdfs(self):
        """GitHub'daki tüm PDF'leri otomatik tara"""
        print("🌐 GitHub'daki PDF'ler taranıyor...")
        
        try:
            headers = {'User-Agent': 'Braille-Book-Reader'}
            response = requests.get(GITHUB_API_URL, headers=headers, timeout=10)
            
            if response.status_code == 200:
                files = response.json()
                books = []
                
                for file in files:
                    if isinstance(file, dict) and file.get('name', '').endswith('.pdf'):
                        # Dosya adından kitap adı oluştur
                        book_name = self.create_book_name(file['name'])
                        
                        books.append({
                            'filename': file['name'],
                            'name_tr': book_name,
                            'download_url': file.get('download_url', ''),
                            'size': file.get('size', 0),
                            'sha': file.get('sha', '')[:8],
                            'last_modified': file.get('git_last_modified', '')
                        })
                
                return books
            else:
                print(f"GitHub API hatası: {response.status_code}")
                
        except requests.exceptions.RequestException as e:
            print(f"İnternet bağlantı hatası: {e}")
        except Exception as e:
            print(f"Tarama hatası: {e}")
        
        return []
    
    def create_book_name(self, filename):
        """Dosya adından güzel Türkçe kitap adı oluştur"""
        # .pdf uzantısını kaldır
        name = filename.replace('.pdf', '')
        
        # Özel karakterleri temizle
        name = name.replace('_', ' ')
        name = name.replace('-', ' ')
        name = name.replace('.', ' ')
        
        # Türkçe karakter düzeltmeleri
        turkish_map = {
            'c': 'ç', 'C': 'Ç',
            'g': 'ğ', 'G': 'Ğ',
            'i': 'ı', 'I': 'İ',
            's': 'ş', 'S': 'Ş',
            'u': 'ü', 'U': 'Ü',
            'o': 'ö', 'O': 'Ö'
        }
        
        for eng, tr in turkish_map.items():
            name = name.replace(eng, tr)
        
        # Başlık formatına çevir (Her kelimenin ilk harfi büyük)
        words = name.split()
        capitalized_words = []
        
        for word in words:
            if word:
                # Özel durumlar
                if word.lower() in ['ve', 'ile', 'de', 'da', 'ki']:
                    capitalized_words.append(word.lower())
                else:
                    capitalized_words.append(word[0].upper() + word[1:].lower())
        
        result = ' '.join(capitalized_words)
        
        # Çok uzunsa kısalt
        if len(result) > 40:
            result = result[:37] + "..."
        
        return result
    
    def download_book(self, book):
        """Tek bir kitabı indir"""
        try:
            if not book.get('download_url'):
                return False
            
            response = requests.get(book['download_url'], timeout=30)
            
            if response.status_code == 200:
                file_path = f"{LOCAL_BOOKS_DIR}/pdfs/{book['filename']}"
                
                with open(file_path, 'wb') as f:
                    f.write(response.content)
                
                # Dosya boyutunu kontrol et
                actual_size = os.path.getsize(file_path)
                if actual_size > 1000:  # En az 1KB
                    print(f"✅ {book['filename']} indirildi ({actual_size:,} byte)")
                    return True
                else:
                    os.remove(file_path)
                    print(f"❌ {book['filename']} boş dosya")
                    return False
                    
        except Exception as e:
            print(f"❌ {book['filename']} indirilemedi: {e}")
        
        return False
    
    def update_library(self, speak_progress=True):
        """Kitaplığı güncelle (manuel)"""
        if speak_progress:
            self.speak("Kitaplar güncelleniyor, lütfen bekleyin.", premium=True)
        
        print("🔄 Kitaplık güncelleniyor...")
        
        # GitHub'dan PDF listesini al
        github_books = self.scan_github_for_pdfs()
        
        if not github_books:
            if speak_progress:
                self.speak("GitHub'dan kitap listesi alınamadı.", premium=True)
            return
        
        if speak_progress:
            self.speak(f"{len(github_books)} kitap bulundu.", premium=True)
        
        # Yeni ve güncellenmiş kitapları bul
        new_books = []
        updated_books = []
        
        for book in github_books:
            local_path = f"{LOCAL_BOOKS_DIR}/pdfs/{book['filename']}"
            
            if not os.path.exists(local_path):
                new_books.append(book)
            else:
                # SHA kontrolü (değişmiş mi?)
                with open(local_path, 'rb') as f:
                    local_sha = hashlib.sha1(f.read()).hexdigest()[:8]
                
                if local_sha != book['sha']:
                    updated_books.append(book)
        
        # İndirme işlemi
        total_books = len(new_books) + len(updated_books)
        
        if total_books == 0:
            if speak_progress:
                self.speak("Tüm kitaplar güncel.", premium=True)
            return
        
        if speak_progress:
            self.speak(f"{len(new_books)} yeni, {len(updated_books)} güncellenecek kitap var.", premium=True)
        
        # İndirmeleri yap
        success_count = 0
        
        for i, book in enumerate(new_books + updated_books):
            if speak_progress and i % 5 == 0:
                self.speak(f"{i+1}. kitap indiriliyor", premium=False)
            
            if self.download_book(book):
                success_count += 1
        
        # Metadata'yı kaydet
        self.save_book_metadata(github_books)
        self.books = github_books
        
        if speak_progress:
            if success_count > 0:
                self.speak(f"Güncelleme tamamlandı. {success_count} kitap eklendi.", premium=True)
            else:
                self.speak("Güncelleme tamamlandı, ancak yeni kitap eklenmedi.", premium=True)
        
        print(f"✅ Güncelleme tamam: {success_count}/{total_books} kitap")
    
    def save_book_metadata(self, books):
        """Kitap metadata'sını kaydet"""
        metadata_path = f"{LOCAL_BOOKS_DIR}/kitaplar_auto.json"
        
        try:
            with open(metadata_path, 'w', encoding='utf-8') as f:
                json.dump(books, f, ensure_ascii=False, indent=2)
            print(f"📁 Metadata kaydedildi: {metadata_path}")
        except Exception as e:
            print(f"Metadata kaydetme hatası: {e}")
    
    def auto_update_check(self):
        """Otomatik güncelleme kontrolü"""
        while self.is_running:
            time.sleep(UPDATE_INTERVAL)
            
            try:
                # İnternet bağlantısını kontrol et
                requests.get("https://api.github.com", timeout=5)
                
                # Sessizce güncelle (kullanıcıyı rahatsız etmeden)
                self.update_library(speak_progress=False)
                
            except:
                pass  # İnternet yoksa sessizce geç
    
    # ==================== GPIO ve BUTON KONTROLÜ ====================
    def setup_gpio(self):
        """GPIO pinlerini ayarla"""
        try:
            # Röle çıkışları
            for pin in GPIOPins.RELAY_PINS:
                GPIO.setup(pin, GPIO.OUT)
                GPIO.output(pin, GPIO.LOW)
            
            # Buton girişleri
            for pin in GPIOPins.ALL_BUTTONS:
                GPIO.setup(pin, GPIO.IN, pull_up_down=GPIO.PUD_UP)
                self.button_states[pin] = GPIO.HIGH
                self.last_button_time[pin] = time.time()
            
            print("✅ GPIO ayarlandı")
            
        except Exception as e:
            print(f"GPIO hatası: {e}")
    
    def check_buttons(self):
        """Butonları polling ile kontrol et"""
        current_time = time.time()
        
        for pin in GPIOPins.ALL_BUTTONS:
            try:
                current_state = GPIO.input(pin)
                last_state = self.button_states.get(pin, GPIO.HIGH)
                
                # Buton basıldı mı? (HIGH -> LOW)
                if current_state == GPIO.LOW and last_state == GPIO.HIGH:
                    # Debounce kontrolü (300ms)
                    if current_time - self.last_button_time.get(pin, 0) > 0.3:
                        self.last_button_time[pin] = current_time
                        self.handle_button_press(pin)
                
                self.button_states[pin] = current_state
                
            except Exception as e:
                print(f"Buton {pin} hatası: {e}")
    
    def handle_button_press(self, pin):
        """Basılan butona göre işlem yap"""
        with self.lock:
            if pin == GPIOPins.BUTTON_NEXT:
                self.next_book()
            elif pin == GPIOPins.BUTTON_CONFIRM:
                self.confirm_selection()
            elif pin == GPIOPins.BUTTON_MODE:
                self.next_mode()
            elif pin == GPIOPins.BUTTON_SPEED_UP:
                self.adjust_speech_speed(increase=True)
            elif pin == GPIOPins.BUTTON_SPEED_DOWN:
                self.adjust_speech_speed(increase=False)
            elif pin == GPIOPins.BUTTON_UPDATE:
                self.manual_update()
    
    def next_book(self):
        """Sonraki kitaba geç"""
        if not self.books:
            self.speak("Henüz kitap yok. Lütfen güncelle tuşuna basın.", premium=True)
            return
        
        self.current_book_index = (self.current_book_index + 1) % len(self.books)
        book = self.books[self.current_book_index]
        
        self.speak(f"{book['name_tr']}", premium=True)
    
    def confirm_selection(self):
        """Kitap veya mod seçimini onayla"""
        if not self.books:
            self.speak("Önce kitapları güncelleyin.", premium=True)
            return
        
        if self.selected_book is None:
            # Kitap seçimi
            self.selected_book = self.books[self.current_book_index]
            book = self.selected_book
            
            self.speak(f"{book['name_tr']} seçildi. Şimdi mod seçmek için mod tuşuna basın.", premium=True)
            time.sleep(1)
            self.speak("Mevcut modlar: Sadece Yazma, Sadece Okuma, Hem Okuma Hem Yazma, Braille Eğitimi", premium=True)
            
        else:
            # Mod seçimi
            self.speak(f"{self.mode_names[self.current_mode]} seçildi. Başlıyor...", premium=True)
            time.sleep(2)
            self.start_reading()
    
    def next_mode(self):
        """Sonraki moda geç"""
        if self.selected_book is None:
            self.speak("Önce bir kitap seçin.", premium=True)
            return
        
        self.current_mode = (self.current_mode + 1) % len(self.modes)
        self.speak(self.mode_names[self.current_mode], premium=True)
    
    def manual_update(self):
        """Manuel güncelleme başlat"""
        Thread(target=self.update_library, args=(True,), daemon=True).start()
    
    # ==================== BRAILLE SİSTEMİ ====================
