        self.mode_names = ["Sadece Yazma", "Sadece Okuma", "Hem Okuma Hem Yazma", "Braille Eğitimi"]
        
        # HIZ AYARLARI - PIPER için
        self.speech_speed = 1.0  # Piper speed: 1.0 normal, 2.0 hızlı, 0.5 yavaş
        self.write_speed = 0.3   # Yazma hızı (saniye/harf)
        self.min_speed = 0.5     # Minimum konuşma hızı
