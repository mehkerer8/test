def install_dependencies():
    """Gerekli paketleri kur"""
    print("📦 Gerekli paketler kuruluyor...")
    
    packages = [
        "espeak", "espeak-data",
        "python3-pip", "poppler-utils"
    ]
    
    for pkg in packages:
        print(f"  → {pkg}")
        subprocess.run(["sudo", "apt", "install", "-y", pkg], 
                      stdout=subprocess.DEVNULL, 
                      stderr=subprocess.DEVNULL)
    
    # Python paketleri
    print("  → requests, RPi.GPIO")
    subprocess.run(["pip3", "install", "requests", "RPi.GPIO"], 
                  stdout=subprocess.DEVNULL, 
                  stderr=subprocess.DEVNULL)
    
    print("✅ Tüm paketler kuruldu")

