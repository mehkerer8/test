# ==================== SES PAKETİ - GELİŞMİŞ KONFİGÜRASYON ====================
class VoiceEngine:
    """Gelişmiş Ses Motoru - Daha yavaş, daha net, daha kaliteli"""
    
    @staticmethod
    def setup():
        """Ses sistemini kur"""
        print("🔊 Gelişmiş ses motoru kuruluyor...")
        
        # Gerekli paketleri kontrol et
        packages = ["espeak", "espeak-ng", "sox", "mbrola", "mbrola-tr1"]
        for pkg in packages:
            try:
                subprocess.run(["dpkg", "-l", pkg], capture_output=True, check=True)
                print(f"✓ {pkg} kurulu")
            except:
                print(f"⚠ {pkg} kurulu değil, kuruluyor...")
                subprocess.run(["sudo", "apt", "install", "-y", pkg], 
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    
    @staticmethod
    def speak_premium(text, wait=True):
        """Premium ses kalitesi - Çok yavaş ve net"""
        try:
            # Metni temizle
            text = VoiceEngine.fix_turkish_text(text)
            
            # Daha kaliteli ses için eSpeak-ng + MBROLA kombinasyonu
            cmd = [
                'espeak-ng',  # Daha gelişmiş eSpeak versiyonu
                '-v', 'tr',    # Türkçe ses
                '-s', '85',    # Çok yavaş (85 kelime/dakika)
                '-a', '200',   # Maksimum ses seviyesi
                '-p', '35',    # Daha kalın ses tonu
                '-g', '12',    # Kelimeler arası boşluk
                '-k', '3',     # Büyük harf vurgusu
                '--punct',     # Noktalamayı oku
                '--ipa',       # Daha net telaffuz
                f'"{text}"'
            ]
            
            if wait:
                subprocess.run(cmd, stdout=subprocess.DEVNULL, 
                             stderr=subprocess.DEVNULL, timeout=len(text)/5)
            else:
                Thread(target=lambda: subprocess.run(cmd, 
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL), 
                       daemon=True).start()
                       
        except subprocess.TimeoutExpired:
            pass
        except Exception as e:
            print(f"Ses hatası (premium): {e}")
            # Fallback: normal eSpeak
            VoiceEngine.speak_normal(text, wait)
    
    @staticmethod
    def speak_normal(text, wait=True, speed=140):
        """Normal ses kalitesi"""
        try:
            text = VoiceEngine.fix_turkish_text(text)
            cmd = ['espeak', '-v', 'tr', '-s', str(speed), '-a', '180', text]
            
            if wait:
                subprocess.run(cmd, stdout=subprocess.DEVNULL, 
                             stderr=subprocess.DEVNULL)
            else:
                Thread(target=lambda: subprocess.run(cmd, 
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL), 
                       daemon=True).start()
        except Exception as e:
            print(f"Ses hatası (normal): {e}")
    
    @staticmethod
    def fix_turkish_text(text):
        """Türkçe karakterleri eSpeak için düzelt"""
        replacements = {
            'ı': 'i', 'İ': 'I',
            'ğ': 'g', 'Ğ': 'G',
            'ü': 'u', 'Ü': 'U',
            'ş': 's', 'Ş': 'S',
            'ö': 'o', 'Ö': 'O',
            'ç': 'c', 'Ç': 'C',
            'â': 'a', 'î': 'i', 'û': 'u'
        }
        for old, new in replacements.items():
            text = text.replace(old, new)
        return text

# ==================== GPIO AYARLARI ====================
class GPIOPins:
    # Röle Pinleri (6 solenoid için)
    RELAY_PINS = [4, 17, 27, 22, 23, 24]
    
    # Buton Pinleri
    BUTTON_NEXT = 5        # Sonraki kitap
    BUTTON_CONFIRM = 6     # Onay/Seçim
    BUTTON_MODE = 13       # Mod değiştirme
    BUTTON_SPEED_UP = 19   # Hız artırma
    BUTTON_SPEED_DOWN = 26 # Hız azaltma
    BUTTON_UPDATE = 21     # Kitapları güncelle
    
    ALL_BUTTONS = [BUTTON_NEXT, BUTTON_CONFIRM, BUTTON_MODE, 
                   BUTTON_SPEED_UP, BUTTON_SPEED_DOWN, BUTTON_UPDATE]

# ==================== BRAILLE KİTAP OKUYUCU ====================
class BrailleBookReader:
    def __init__(self):
        print("🎵 YÜKSEK KALİTELİ BRAİLLE KİTAP OKUYUCU")
        print("=" * 50)
        
