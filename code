# ==================== PIPER TTS SES SİSTEMİ ====================
class PiperVoiceEngine:
    """Piper TTS ile Yüksek Kaliteli Türkçe Ses"""
    
    def __init__(self):
        self.voice = None
        self.lock = Lock()
        self.setup()
    
    def setup(self):
        """Piper TTS'yi başlat"""
        print("🔊 Piper TTS kuruluyor...")
        
        try:
            # Model dosyasını kontrol et
            if not os.path.exists(PIPER_MODEL_PATH):
                print("❌ Piper modeli bulunamadı! İndiriliyor...")
                self.download_piper_model()
            
            # Piper ses motorunu yükle
            with self.lock:
                self.voice = PiperVoice.load(PIPER_MODEL_PATH)
            
            print("✅ Piper TTS başarıyla yüklendi")
            
        except Exception as e:
            print(f"❌ Piper TTS yükleme hatası: {e}")
            print("⚠️ eSpeak'a geri dönülüyor...")
            self.voice = None
    
    def download_piper_model(self):
        """Piper modelini indir"""
        try:
            os.makedirs(os.path.dirname(PIPER_MODEL_PATH), exist_ok=True)
            
            print("📥 Piper Türkçe modeli indiriliyor...")
            
            model_url = "https://huggingface.co/datasets/rhasspy/piper-voices/resolve/main/tr/tr_TR/ff/low/tr_TR-ff-low.onnx"
            config_url = "https://huggingface.co/datasets/rhasspy/piper-voices/resolve/main/tr/tr_TR/ff/low/tr_TR-ff-low.onnx.json"
            
            # Modeli indir
            response = requests.get(model_url, timeout=60)
            with open(PIPER_MODEL_PATH, 'wb') as f:
                f.write(response.content)
            
            # Config'i indir
            config_path = PIPER_MODEL_PATH + ".json"
            response = requests.get(config_url, timeout=60)
            with open(config_path, 'wb') as f:
                f.write(response.content)
            
            print("✅ Piper modeli indirildi")
            
        except Exception as e:
            print(f"❌ Model indirme hatası: {e}")
    
    def speak(self, text, wait=True, speed=1.0):
        """
        Piper TTS ile yüksek kaliteli seslendirme
        speed: 0.5 (yavaş) - 2.0 (hızlı)
        """
        if self.voice is None:
            return self.speak_fallback(text, wait)
        
        try:
            # Metni optimize et
            text = self.fix_turkish_text(text)
            
            # Ses parametreleri
            sentences = self.split_into_sentences(text)
            
            if wait:
                for sentence in sentences:
                    if sentence.strip():
                        self._speak_sentence(sentence, speed)
            else:
                # Asenkron konuşma
                Thread(target=self._speak_async, args=(text, speed), daemon=True).start()
                
        except Exception as e:
            print(f"Piper TTS hatası: {e}")
            self.speak_fallback(text, wait)
    
    def _speak_sentence(self, sentence, speed):
        """Tek bir cümleyi seslendir"""
        try:
            # WAV verisi oluştur
            with self.lock:
                audio_data = self.voice.synthesize(
                    sentence,
                    length_scale=1.0/speed,  # Hız kontrolü
                    noise_scale=0.667,
                    noise_w=0.8
                )
            
            # Ses çal
            sd.play(audio_data.audio, audio_data.sample_rate)
            sd.wait()
            
        except Exception as e:
            print(f"Cümle seslendirme hatası: {e}")
    
    def _speak_async(self, text, speed):
        """Asenkron seslendirme"""
        self.speak(text, wait=True, speed=speed)
    
    def speak_fallback(self, text, wait=True):
        """eSpeak fallback"""
        try:
            text = self.fix_turkish_text(text)
            cmd = ['espeak', '-v', 'tr+f3', '-s', '160', text]
            
            if wait:
                subprocess.run(cmd, stdout=subprocess.DEVNULL, 
                             stderr=subprocess.DEVNULL)
            else:
                Thread(target=lambda: subprocess.run(cmd, 
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL), 
                       daemon=True).start()
        except Exception as e:
            print(f"Fallback ses hatası: {e}")
    
    def split_into_sentences(self, text):
        """Metni cümlelere ayır"""
        sentences = []
        current = ""
        
        for char in text:
            current += char
            if char in '.!?。！？':
                sentences.append(current.strip())
                current = ""
        
        if current.strip():
            sentences.append(current.strip())
        
        return sentences if sentences else [text]
    
    def fix_turkish_text(self, text):
        """Türkçe karakterleri düzelt (Piper için gerekli değil ama ekliyorum)"""
        return text

# ==================== GPIO AYARLARI ====================
class GPIOPins:
    # Röle Pinleri (6 solenoid için)
    RELAY_PINS = [4, 17, 27, 22, 23, 24]
    
    # Buton Pinleri
    BUTTON_NEXT = 5        # Sonraki kitap
    BUTTON_CONFIRM = 6     # Onay/Seçim
    BUTTON_MODE = 13       # Mod değiştirme
    BUTTON_SPEED_UP = 19   # Hız artırma
    BUTTON_SPEED_DOWN = 26 # Hız azaltma
    BUTTON_UPDATE = 21     # Kitapları güncelle
    
    ALL_BUTTONS = [BUTTON_NEXT, BUTTON_CONFIRM, BUTTON_MODE, 
                   BUTTON_SPEED_UP, BUTTON_SPEED_DOWN, BUTTON_UPDATE]

# ==================== BRAILLE KİTAP OKUYUCU ====================
