    def set_solenoids(self, pattern):
        """Solenoidleri kontrol et"""
        for i, state in enumerate(pattern[:6]):
            if i < len(GPIOPins.RELAY_PINS):
                GPIO.output(GPIOPins.RELAY_PINS[i], GPIO.HIGH if state else GPIO.LOW)
    
    def clear_solenoids(self):
        """Tüm solenoidleri kapat"""
        for pin in GPIOPins.RELAY_PINS:
            GPIO.output(pin, GPIO.LOW)
    
    # ==================== PDF OKUMA ve MODLAR ====================
    def read_pdf_content(self, book):
        """PDF içeriğini oku"""
        pdf_path = f"{LOCAL_BOOKS_DIR}/pdfs/{book['filename']}"
        
        if not os.path.exists(pdf_path):
            self.speak("Kitap dosyası bulunamadı.", premium=True)
            return ""
        
        try:
            # pdftotext kullanarak PDF'den metin çıkar
            temp_file = "/tmp/kitap_temp.txt"
            
            cmd = ["pdftotext", "-layout", "-enc", "UTF-8", pdf_path, temp_file]
            result = subprocess.run(cmd, capture_output=True, text=True)
            
            if result.returncode == 0 and os.path.exists(temp_file):
                with open(temp_file, 'r', encoding='utf-8') as f:
                    text = f.read()
                
                os.remove(temp_file)
                
                # Metni temizle
                text = text.replace('\n', ' ')
                text = ' '.join(text.split())  # Fazla boşlukları temizle
                
                return text if text.strip() else ""
            else:
                print(f"PDF okuma hatası: {result.stderr}")
                return ""
                
        except Exception as e:
            print(f"PDF işleme hatası: {e}")
            return ""
    
    def start_reading(self):
        """Okumaya başla"""
        if not self.selected_book:
            return
        
        # Önceki okumayı durdur
        self.stop_event.set()
        self.is_playing = False
        time.sleep(0.5)
        self.stop_event.clear()
        
        # PDF'i yükle
        self.speak("Kitap yükleniyor, lütfen bekleyin.", premium=True)
        self.current_text = self.read_pdf_content(self.selected_book)
        
        if not self.current_text:
            self.speak("Kitap okunamadı veya boş.", premium=True)
            return
        
        # İlerlemeden devam et
        book_key = self.selected_book['filename']
        if book_key in self.progress_data:
            self.current_position = self.progress_data[book_key]['position']
            self.speak("Kayıtlı yerden devam ediliyor.", premium=True)
        else:
            self.current_position = 0
        
        self.is_playing = True
        
        # Moda göre başla
        mode_func = {
            "sadece_yazma": self.mode_write_only,
            "sadece_okuma": self.mode_read_only,
            "hem_okuma_hem_yazma": self.mode_read_and_write,
            "egitim_modu": self.mode_education
        }
        
        mode_func.get(self.modes[self.current_mode], self.mode_read_only)()
    
    def mode_write_only(self):
        """Sadece yazma modu"""
        self.speak("Sadece yazma modu başlıyor.", premium=True)
        # ... Braille yazma kodu ...
    
    def mode_read_only(self):
        """Sadece okuma modu"""
        self.speak("Okuma modu başlıyor.", premium=True)
        time.sleep(1)
        
        # Metni parçalara böl
        chunk_size = 500
        text_to_read = self.current_text[self.current_position:]
        
        for i in range(0, len(text_to_read), chunk_size):
            if self.stop_event.is_set() or not self.is_playing:
                break
            
            chunk = text_to_read[i:i+chunk_size]
            self.speak(chunk, premium=True)
            
            self.current_position += len(chunk)
            
            # Her 5 chunk'ta bir ilerlemeyi kaydet
            if (i // chunk_size) % 5 == 0:
                self.save_progress()
    
    def mode_read_and_write(self):
        """Hem oku hem yaz modu"""
        self.speak("Okuma ve yazma modu başlıyor.", premium=True)
        # ... Kombine kod ...
    
    def mode_education(self):
        """Braille eğitim modu"""
        self.speak("Braille eğitim modu başlıyor.", premium=True)
        # ... Eğitim kodu ...
    
    # ==================== İLERLEME YÖNETİMİ ====================
    def load_progress(self):
        """İlerlemeyi yükle"""
        progress_file = f"{LOCAL_BOOKS_DIR}/progress.json"
        
        if os.path.exists(progress_file):
            try:
                with open(progress_file, 'r', encoding='utf-8') as f:
                    self.progress_data = json.load(f)
                print("✅ İlerleme verisi yüklendi")
            except:
                self.progress_data = {}
    
    def save_progress(self):
        """İlerlemeyi kaydet"""
        if not self.selected_book:
            return
        
        try:
            book_key = self.selected_book['filename']
            self.progress_data[book_key] = {
                'position': self.current_position,
                'mode': self.current_mode,
                'timestamp': time.time(),
                'book_name': self.selected_book['name_tr']
            }
            
            progress_file = f"{LOCAL_BOOKS_DIR}/progress.json"
            with open(progress_file, 'w', encoding='utf-8') as f:
                json.dump(self.progress_data, f, ensure_ascii=False, indent=2)
                
        except Exception as e:
            print(f"İlerleme kaydetme hatası: {e}")
    
    # ==================== ANA DÖNGÜ ====================
    def main_loop(self):
        """Ana program döngüsü"""
        try:
            while self.is_running:
                self.check_buttons()
                time.sleep(0.05)  # 50ms bekle
                
        except KeyboardInterrupt:
            print("\n⏹️ Kullanıcı tarafından durduruldu")
            self.cleanup()
        except Exception as e:
            print(f"Ana döngü hatası: {e}")
            self.cleanup()
    
    def cleanup(self):
        """Sistemi temizle ve kapat"""
        print("🛑 Sistem kapatılıyor...")
        self.is_running = False
        self.stop_event.set()
        self.is_playing = False
        
        time.sleep(1)
        self.clear_solenoids()
        
        # İlerlemeyi kaydet
        self.save_progress()
        
        GPIO.cleanup()
        print("✅ Sistem güvenle kapatıldı")

