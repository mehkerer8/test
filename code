#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import os
import time
import glob
import json
import subprocess
import threading
from threading import Thread, Lock, Event
import RPi.GPIO as GPIO

# GPIO Pin Tanımlamaları - GÜNCELLENMİŞ
class GPIOPins:
    # Röle Pinleri (daha az çakışan pinler)
    RELAY_PINS = [4, 17, 27, 22, 23, 24]  # 6 adet GPIO pin
    
    # Buton Pinleri
    BUTTON_NEXT_PDF = 5      # Sonraki PDF
    BUTTON_CONFIRM = 6       # Onay butonu
    BUTTON_MODE_SELECT = 13  # Mod seçme
    BUTTON_SPEED_UP = 19     # Hız artırma
    BUTTON_SPEED_DOWN = 26   # Hız azaltma
    BUTTON_SAVE_PROGRESS = 16 # GPIO 16
    
    # Tüm butonların listesi
    ALL_BUTTONS = [BUTTON_NEXT_PDF, BUTTON_CONFIRM, BUTTON_MODE_SELECT, 
                   BUTTON_SPEED_UP, BUTTON_SPEED_DOWN, BUTTON_SAVE_PROGRESS]

class BrailleMachine:
    def __init__(self):
        print("Braille Kitap Okuma Makinesi başlatılıyor...")
        
        # GPIO Ayarları
        GPIO.setmode(GPIO.BCM)
        GPIO.setwarnings(False)  # RuntimeWarning'leri gizle
        
        # Önce GPIO'yu temizle
        try:
            GPIO.cleanup()
            time.sleep(0.5)
        except:
            pass
        
        # Değişkenler
        self.current_pdf_index = 0
        self.pdf_files = []
        self.selected_pdf = None
        self.current_mode = 0
        self.modes = ["sadece_yazma", "sadece_okuma", "hem_okuma_hem_yazma", "egitim_modu"]
        self.mode_names = ["Sadece Yazma Modu", "Sadece Okuma Modu", "Hem Okuma Hem Yazma Modu", "Braille Eğitim Modu"]
        self.speech_speed = 150
        self.is_running = True
        self.progress_data = {}
        self.current_position = 0
        self.current_text = ""
        self.is_playing = False
        self.stop_event = Event()
        
        # Kilitleme mekanizması
        self.lock = Lock()
        
        # Buton durum takibi
        self.button_states = {}
        self.last_button_time = {}
        
        # Pinleri ayarla (POLLING yöntemi)
        self.setup_pins_polling()
        
        # Braille haritasını yükle
        self.setup_comprehensive_braille_map()
        
        # İlerleme dosyasını yükle
        self.load_progress()
        
        # USB kontrol thread'i başlat
        self.usb_check_thread = Thread(target=self.check_usb_loop, daemon=True)
        self.usb_check_thread.start()
        
        print("Sistem hazır! USB bekleniyor...")

    def setup_pins_polling(self):
        """GPIO pinlerini polling yöntemiyle ayarla"""
        try:
            # Röle çıkışları
            for pin in GPIOPins.RELAY_PINS:
                GPIO.setup(pin, GPIO.OUT)
                GPIO.output(pin, GPIO.LOW)
                print(f"✓ Röle pin {pin} ayarlandı")
            
            # Buton girişleri (pull-up)
            for pin in GPIOPins.ALL_BUTTONS:
                GPIO.setup(pin, GPIO.IN, pull_up_down=GPIO.PUD_UP)
                self.button_states[pin] = GPIO.HIGH  # Başlangıç durumu
                self.last_button_time[pin] = time.time()
                print(f"✓ Buton pin {pin} ayarlandı")
            
        except Exception as e:
            print(f"✗ GPIO kurulum hatası: {e}")

